# Aynur Tümen web sitesi
Options -Indexes
DirectoryIndex index.php
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On
  # www'suz adres -> www (https yönlendirmesini Hostinger'ın "HTTPS'i zorla" ayarı yapar)
  RewriteCond %{HTTP_HOST} ^aynurtumen\.com\.tr$ [NC]
  RewriteRule ^ https://www.aynurtumen.com.tr%{REQUEST_URI} [L,R=301]
  # Gizli dosyalara erişim yok
  RewriteRule (^|/)\.(?!well-known) - [F]
  RewriteRule ^app/ - [F]
  # Var olan dosyalar (görsel, stil, yazı tipi) doğrudan, gerisi index.php'ye
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/plain
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
